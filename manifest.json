{
  "manifest_version": 3,
  "name": "Drive Private Video Downloader",
  "version": "2.0",
  "description": "Download google drive private share video.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "64": "icon.png",
    "128": "icon.png",
    "256": "icon.png",
    "512": "icon.png"
  },
  "permissions": [
    "debugger",
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
     "https://drive.google.com/*",
     "https://docs.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*", "https://docs.google.com/*"],
      "js": ["sidebar.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "icon.png"],
      "matches": ["https://drive.google.com/*", "https://docs.google.com/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon.png",
      "24": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "64": "icon.png",
      "128": "icon.png",
      "256": "icon.png",
      "512": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
